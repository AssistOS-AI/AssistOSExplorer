{
  "tools": [
    {
      "name": "robot_create",
      "title": "Create robot",
      "description": "Creates a persistent robot owned by the authenticated user.",
      "command": "node",
      "args": ["tools/control.mjs", "robot-create"],
      "cwd": "/code",
      "timeoutMs": 30000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "specialization": { "type": "string", "maxLength": 500 }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    {
      "name": "robot_list",
      "title": "List robots",
      "description": "Lists persistent robots owned by the authenticated user.",
      "command": "node",
      "args": ["tools/control.mjs", "robot-list"],
      "cwd": "/code",
      "timeoutMs": 30000,
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
    },
    {
      "name": "robot_start",
      "title": "Start robot",
      "description": "Starts one robot container in browser or desktop mode.",
      "command": "node",
      "args": ["tools/control.mjs", "robot-start"],
      "cwd": "/code",
      "timeoutMs": 600000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "robotId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
          "mode": { "type": "string", "enum": ["browser", "desktop"] }
        },
        "required": ["robotId", "mode"],
        "additionalProperties": false
      }
    },
    {
      "name": "robot_stop",
      "title": "Stop robot",
      "description": "Stops the active robot container while preserving its home and work files.",
      "command": "node",
      "args": ["tools/control.mjs", "robot-stop"],
      "cwd": "/code",
      "timeoutMs": 30000,
      "inputSchema": {
        "type": "object",
        "properties": { "robotId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" } },
        "required": ["robotId"],
        "additionalProperties": false
      }
    },
    {
      "name": "robot_logs",
      "title": "Read robot logs",
      "description": "Returns the bounded log tail for the active robot container.",
      "command": "node",
      "args": ["tools/control.mjs", "robot-logs"],
      "cwd": "/code",
      "timeoutMs": 30000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "robotId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
          "tail": { "type": "integer", "minimum": 1, "maximum": 1000 }
        },
        "required": ["robotId"],
        "additionalProperties": false
      }
    }
  ]
}
