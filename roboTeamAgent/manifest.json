{
  "container": "docker.io/assistos/roboteam-agent:runtime",
  "about": "Manages persistent robots and starts authenticated browser or Linux desktop containers with nested Podman.",
  "containerSecurity": {
    "nestedPodman": true
  },
  "agent": "exec sh /code/scripts/startAgent.sh",
  "cli": "node /code/server/robot-cli.mjs",
  "enable": [
    "soul-gateway no-wait",
    "robo-work global"
  ],
  "webchat": {
    "auth": "static",
    "forwardEnvelope": true,
    "runtimeScope": "principal",
    "delegations": [
      {
        "key": "providerAdmission",
        "targetAgentId": "agent:./robo-work",
        "tools": [
          "__coordinator_admission__"
        ],
        "scopes": [
          "execution:owner"
        ],
        "ttlSeconds": 30
      }
    ]
  },
  "readiness": {
    "protocol": "mcp",
    "timeoutSeconds": 45
  },
  "health": {
    "readiness": {
      "interval": 1,
      "timeout": 1,
      "failureThreshold": 45,
      "successThreshold": 1
    }
  },
  "webtty": {
    "homeProfiles": {
      "version": 1,
      "resolve": "/base-agent-additional-server/roboTeamAgent/3001/api/terminal-profiles/resolve"
    }
  },
  "routerAccess": {
    "httpRoutes": [
      {
        "path": "/base-agent-additional-server/roboTeamAgent/3001/api/worker/*",
        "access": "authenticated",
        "delegations": [
          {
            "key": "providerAdmission",
            "targetAgentId": "agent:./robo-work",
            "tools": [
              "__coordinator_admission__"
            ],
            "scopes": [
              "execution:owner"
            ],
            "ttlSeconds": 30
          }
        ]
      },
      {
        "path": "/base-agent-additional-server/roboTeamAgent/3001/api/robots/*",
        "access": "authenticated",
        "delegations": [
          {
            "key": "providerAdmission",
            "targetAgentId": "agent:./robo-work",
            "tools": [
              "__coordinator_admission__"
            ],
            "scopes": [
              "execution:owner"
            ],
            "ttlSeconds": 30
          }
        ]
      },
      {
        "path": "/base-agent-additional-server/roboTeamAgent/3001/api/roboflow/flows",
        "access": "authenticated",
        "delegations": [
          {
            "key": "providerAdmission",
            "targetAgentId": "agent:./robo-work",
            "tools": [
              "__coordinator_admission__"
            ],
            "scopes": [
              "execution:owner"
            ],
            "ttlSeconds": 30
          }
        ]
      },
      {
        "path": "/base-agent-additional-server/roboTeamAgent/3001/api/roboflow/schedules/*",
        "access": "authenticated",
        "delegations": [
          {
            "key": "providerAdmission",
            "targetAgentId": "agent:./robo-work",
            "tools": [
              "__coordinator_admission__"
            ],
            "scopes": [
              "execution:owner"
            ],
            "ttlSeconds": 30
          }
        ]
      },
      {
        "path": "/base-agent-additional-server/roboTeamAgent/3001/api/control",
        "access": "authenticated",
        "delegations": [
          {
            "key": "providerAdmission",
            "targetAgentId": "agent:./robo-work",
            "tools": [
              "__coordinator_admission__"
            ],
            "scopes": [
              "execution:owner"
            ],
            "ttlSeconds": 30
          }
        ]
      },
      {
        "path": "/base-agent-additional-server/roboTeamAgent/3001/api/roboflow/human-input/answer",
        "access": "authenticated",
        "delegations": [
          {
            "key": "providerAdmission",
            "targetAgentId": "agent:./robo-work",
            "tools": [
              "__coordinator_admission__"
            ],
            "scopes": [
              "execution:owner"
            ],
            "ttlSeconds": 30
          }
        ]
      },
      {
        "path": "/base-agent-additional-server/roboTeamAgent/3001/*",
        "access": "authenticated"
      }
    ]
  },
  "volumes": {
    ".data/roboTeamAgent": "/data"
  },
  "profiles": {
    "default": {
      "openPorts": [
        "7000:7000",
        "3001:3001"
      ],
      "install": "sh /code/scripts/install.sh",
      "env": [
        "ROBOTEAM_CODEX_VERSION",
        "ROBOTEAM_OPENCODE_VERSION",
        "ROBOTEAM_PI_VERSION",
        "ROBOTEAM_CLAUDE_VERSION",
        {
          "name": "ROBOTEAM_WORKER_COORDINATOR_BASE",
          "value": "/base-agent-additional-server/robo-work/7000"
        }
      ]
    }
  },
  "link-install": [
    "https://github.com/AssistOS-AI/AdvancedLanguageAgent.git",
    "https://github.com/AssistOS-AI/DocumentationSkills.git"
  ]
}
