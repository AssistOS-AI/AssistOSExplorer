{
  "container": "docker.io/assistos/roboteam-agent:runtime",
  "about": "Manages robot conversations, tasks, workflows and Copilot through the RoboWork runtime.",
  "agent": "exec sh /code/scripts/startAgent.sh",
  "cli": "node /code/server/robot-cli.mjs",
  "enable": [
    "soul-gateway no-wait",
    "roboWorkAgent global no-wait"
  ],
  "webchat": {
    "auth": "static",
    "forwardEnvelope": true
  },
  "readiness": {
    "protocol": "mcp",
    "timeoutSeconds": 45
  },
  "health": {
    "readiness": {
      "interval": 1,
      "timeout": 1,
      "failureThreshold": 45,
      "successThreshold": 1
    }
  },
  "routerAccess": {
    "httpRoutes": [
      {
        "path": "/base-agent-additional-server/roboTeamAgent/3001/*",
        "access": "authenticated"
      }
    ]
  },
  "volumes": {
    ".data/roboTeamAgent": "/data"
  },
  "profiles": {
    "default": {
      "openPorts": [
        "7000:7000",
        "3001:3001"
      ],
      "install": "sh /code/scripts/install.sh"
    }
  },
  "link-install": [
    "https://github.com/AssistOS-AI/AdvancedLanguageAgent.git",
    "https://github.com/AssistOS-AI/DocumentationSkills.git"
  ]
}
