          "type": "boolean",
          "optional": true
        },
        "maxResults": {
          "type": "number",
          "optional": true
        },
        "excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "optional": true
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "optional": true
