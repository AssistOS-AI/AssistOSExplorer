    },
    {
      "name": "apply_markdown_crdt_change",
      "description": "Apply an incremental Markdown CRDT change to an Automerge document.",
      "command": "tools/explorer_tool.sh",
      "cwd": "workspace",
      "env": {
        "TOOL_NAME": "apply_markdown_crdt_change"
      },
      "inputSchema": {
        "documentId": {
          "type": "string"
        },
        "baseHeads": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "optional": true
        },
        "operation": {
          "type": "string",
          "enum": [
            "replaceTextRange",
            "replaceDocumentFromMarkdown",
            "replaceDocumentModel",
            "updateDocument",
            "updateDocumentMetadata",
            "addChapter",
            "deleteChapter",
            "reorderChapter",
            "updateChapter",
            "addParagraph",
            "deleteParagraph",
            "reorderParagraph",
            "updateParagraph",
            "updateMetadata"
          ]
        },
        "changeJson": {
          "type": "string",
          "optional": true
        },
        "change": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "optional": true
            },
            "from": {
              "type": "number",
              "optional": true
            },
            "deleteCount": {
              "type": "number",
              "optional": true
            },
            "insertText": {
              "type": "string",
              "optional": true
            },
            "markdown": {
              "type": "string",
              "optional": true
            },
            "model": {
              "type": "object",
              "optional": true
            },
            "metadata": {
              "type": "object",
              "optional": true
            },
            "patch": {
              "type": "object",
              "optional": true
            },
            "chapter": {
              "type": "object",
              "optional": true
            },
            "paragraph": {
              "type": "object",
              "optional": true
            },
            "chapterId": {
              "type": "string",
              "optional": true
            },
            "paragraphId": {
              "type": "string",
              "optional": true
            },
            "position": {
              "type": "number",
              "optional": true
            },
            "title": {
              "type": "string",
              "optional": true
            },
            "infoText": {
              "type": "string",
              "optional": true
            },
            "text": {
              "type": "string",
              "optional": true
            },
            "target": {
              "type": "string",
              "optional": true
            }
          }
        }
      }
    },
    {
      "name": "merge_markdown_crdt_document",
