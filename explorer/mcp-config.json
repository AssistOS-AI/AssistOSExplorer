      "cwd": "workspace",
      "tags": ["internal"],
      "env": { "TOOL_NAME": "scripta_crdt_workspace_list" },
      "inputSchema": {
        "defaultFolder": { "type": "string" }
      }
    },
    {
      "name": "scripta_crdt_create",
      "description": "Create a SCRIPTA Markdown document in Automerge.",
      "command": "tools/explorer_tool.sh",
      "cwd": "workspace",
      "tags": ["internal"],
      "env": { "TOOL_NAME": "scripta_crdt_create" },
      "inputSchema": {
        "path": { "type": "string" },
        "title": { "type": "string" },
        "template": { "type": "string", "enum": ["vision", "plan", "general"] },
        "initialization": {
          "type": "object",
          "optional": true,
          "properties": {
            "title": { "type": "string", "optional": true },
            "objective": { "type": "string", "optional": true },
            "chapterTitle": { "type": "string", "optional": true },
            "visionParagraphs": {
              "type": "array",
              "optional": true,
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "optional": true },
                  "text": { "type": "string", "optional": true }
                }
              }
            },
            "planParagraphs": {
              "type": "array",
              "optional": true,
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "optional": true },
                  "text": { "type": "string", "optional": true }
                }
              }
            },
            "chapters": {
              "type": "array",
              "optional": true,
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "optional": true },
                  "title": { "type": "string", "optional": true },
                  "paragraphs": {
                    "type": "array",
                    "optional": true,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "optional": true },
                        "text": { "type": "string", "optional": true }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "createdBy": { "type": "string", "optional": true },
        "resourceId": { "type": "string", "optional": true },
        "viewerHash": { "type": "string", "optional": true },
        "view": {
          "type": "object",
          "optional": true,
          "properties": {
            "mode": { "type": "string", "enum": ["document", "paragraph"], "optional": true },
            "chapterId": { "type": "string", "optional": true },
            "paragraphId": { "type": "string", "optional": true },
            "selectedVariantId": { "type": "string", "optional": true },
            "editingVariantId": { "type": "string", "optional": true },
            "editorParticipantId": { "type": "string", "optional": true },
            "focusTargetType": { "type": "string", "enum": ["chapter", "paragraph"], "optional": true },
            "autoFocusRevision": { "type": "number", "optional": true }
          }
        }
      }
    },
    {
      "name": "scripta_crdt_open",
