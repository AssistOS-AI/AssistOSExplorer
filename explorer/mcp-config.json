      "command": "tools/explorer_tool.sh",
      "cwd": "workspace",
      "tags": ["internal"],
      "env": { "TOOL_NAME": "scripta_crdt_open" },
      "inputSchema": {
        "path": { "type": "string" },
        "resourceId": { "type": "string", "optional": true },
        "viewerHash": { "type": "string" },
        "view": {
          "type": "object",
          "optional": true,
          "properties": {
            "mode": { "type": "string", "enum": ["document", "paragraph"], "optional": true },
            "chapterId": { "type": "string", "optional": true },
            "paragraphId": { "type": "string", "optional": true },
            "selectedVariantId": { "type": "string", "optional": true },
            "editingVariantId": { "type": "string", "optional": true },
            "editorParticipantId": { "type": "string", "optional": true },
            "focusTargetType": { "type": "string", "enum": ["chapter", "paragraph"], "optional": true },
            "autoFocusRevision": { "type": "number", "optional": true }
          }
        },
        "participantMap": { "type": "object", "additionalProperties": true, "optional": true }
      }
    },
    {
      "name": "scripta_crdt_mutate",
      "description": "Atomically mutate and save a SCRIPTA Automerge document.",
      "command": "tools/explorer_tool.sh",
      "cwd": "workspace",
      "tags": ["internal"],
      "env": { "TOOL_NAME": "scripta_crdt_mutate" },
      "inputSchema": {
        "path": { "type": "string" },
        "resourceId": { "type": "string", "optional": true },
        "operation": {
          "type": "string",
          "enum": [
            "p-variant-add",
            "p-variant-vote",
            "p-variant-vote-withdraw",
            "p-variant-edit",
            "p-variant-delete",
            "p-variant-image-insert",
            "p-variant-image-replace",
            "p-variant-image-delete",
            "p-variant-image-layout",
            "chapter-add",
            "chapter-delete",
            "chapter-rename",
            "chapter-move",
            "paragraph-add",
            "paragraph-delete",
            "paragraph-move",
            "undo"
          ]
        },
        "args": {
          "type": "object",
          "optional": true,
          "properties": {
            "chapterId": { "type": "string", "optional": true },
            "paragraphId": { "type": "string", "optional": true },
            "variantId": { "type": "string", "optional": true },
            "variantOrdinal": { "type": "number", "optional": true },
            "type": { "type": "string", "optional": true },
            "text": { "type": "string", "optional": true },
            "title": { "type": "string", "optional": true },
            "targetChapterId": { "type": "string", "optional": true },
            "targetIndex": { "type": "number", "optional": true },
            "roomId": { "type": "string", "optional": true },
            "roomFolderPath": { "type": "string", "optional": true },
            "assetId": { "type": "string", "optional": true },
            "imageId": { "type": "string", "optional": true },
            "imageOrdinal": { "type": "number", "optional": true },
            "alt": { "type": "string", "optional": true },
            "position": { "type": "number", "optional": true },
            "widthPercent": { "type": "number", "optional": true },
            "aspectRatio": { "type": "string", "enum": ["auto", "1:1", "4:3", "3:2", "16:9"], "optional": true },
            "fit": { "type": "string", "enum": ["contain", "cover"], "optional": true },
            "alignment": { "type": "string", "enum": ["left", "center", "right"], "optional": true },
            "showCaption": { "type": "boolean", "optional": true }
          }
        },
        "participant": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "hash": { "type": "string" },
            "label": { "type": "string" }
          }
        },
        "viewerHash": { "type": "string", "optional": true },
        "view": {
          "type": "object",
          "optional": true,
          "properties": {
            "mode": { "type": "string", "enum": ["document", "paragraph"], "optional": true },
            "chapterId": { "type": "string", "optional": true },
            "paragraphId": { "type": "string", "optional": true },
            "selectedVariantId": { "type": "string", "optional": true },
            "editingVariantId": { "type": "string", "optional": true },
            "editorParticipantId": { "type": "string", "optional": true },
            "focusTargetType": { "type": "string", "enum": ["chapter", "paragraph"], "optional": true },
            "autoFocusRevision": { "type": "number", "optional": true }
          }
        },
        "participantMap": { "type": "object", "additionalProperties": true, "optional": true }
      }
    },
    {
      "name": "scripta_crdt_delete",
