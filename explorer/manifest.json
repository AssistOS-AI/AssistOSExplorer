{
    "container": "docker.io/assistos/ploinky-node@sha256:accd925fcbf460c1f4c7a5cd9e2d46539c615bbfad2e896cabb7556d8050a669",
    "lite-sandbox": true,
    "update": "",
    "cli": "/bin/bash",
    "about": "AssistOS Explorer agent",
    "ploinky": "sso enable",
    "sso": {
        "providerAgent": "userPersistoAgent"
    },
    "enable": [
        {
            "agent": "gitAgent global",
            "profile": "embedded"
        },
        "userPersistoAgent",
        "dpuAgent global",
        "soplangAgent global no-wait",
        "tasksAgent global",
        "AchillesCLI/roboTeamAgent global no-wait",
        "AchillesIDE/liveKitServerAgent no-wait",
        "webmeetAgent global no-wait",
        "multimedia global no-wait",
        "proxies/soul-gateway no-wait",
        "webAssist no-wait",
        "UmamiAgent/umamiAgent no-wait",
        "workspaceMonitorAgent no-wait"
    ],
    "repos": {
        "container-image-builds": "https://github.com/AssistOS-AI/container-image-builds.git",
        "UmamiAgent": "https://github.com/AssistOS-AI/UmamiAgent.git"
    },
    "applicationPlugins": {
        "git": true,
        "dpu-runtime-support": true,
        "workspace-monitor": true,
        "help": true,
        "soplang-builder": true,
        "tasks": true,
        "webmeet": true,
        "soul-gateway": true
    },
    "routerAccess": {
        "requiredCapability": "explorer.access",
        "capabilityDeniedRedirect": "/base-agent-additional-server/userPersistoAgent/7000/service/dashboard/",
        "httpRoutes": [
            {
                "path": "/shared/*",
                "access": "public"
            },
            {
                "path": "/web-components/components/*",
                "access": "public"
            }
        ]
    },
    "volumes": {
        ".ploinky/repos": "/workspace/.ploinky/repos"
    },
    "profiles": {
        "default": {
            "env": [
                "ASSISTOS_FS_ROOT",
                {
                    "name": "AXIFACE_REPO_PATH",
                    "required": false
                }
            ],
            "preinstall": "scripts/hooks/preinstall.sh"
        }
    }
}
