{
    "container": "docker.io/assistos/ploinky-node@sha256:accd925fcbf460c1f4c7a5cd9e2d46539c615bbfad2e896cabb7556d8050a669",
    "lite-sandbox": true,
    "update": "",
    "cli": "/bin/bash",
    "about": "AssistOS Explorer agent",
    "ploinky": "sso enable",
    "sso": {
        "providerAgent": "userPersistoAgent"
    },
    "enable": [
        {
            "agent": "gitAgent global",
            "profile": "embedded"
        },
        {
            "agent": "userPersistoAgent",
            "profile": "explorer"
        },
        "dpuAgent global",
        "legacy-agents/soplangAgent global no-wait",
        "legacy-agents/tasksAgent global",
        "roboTeamAgent global no-wait",
        "webmeet/liveKitServerAgent no-wait",
        "webmeet/webmeetAgent global no-wait",
        "legacy-agents/multimedia global no-wait",
        "soul-gateway no-wait",
        "legacy-agents/webAssist no-wait",
        "workspaceMonitorAgent no-wait",
        "local-llms/local-llm no-wait"
    ],
    "repos": {
        "legacy-agents": "https://github.com/AssistOS-AI/legacy-agents.git",
        "webmeet": "https://github.com/AssistOS-AI/webmeet.git",
        "OnlyOfficeAgent": "https://github.com/AssistOS-AI/OnlyOfficeAgent.git",
        "UmamiAgent": "https://github.com/AssistOS-AI/UmamiAgent.git",
        "local-llms": "https://github.com/AssistOS-AI/local-llms.git"
    },
    "applicationPlugins": {
        "git": true,
        "dpu-runtime-support": true,
        "workspace-monitor": true,
        "help": true,
        "soplang-builder": true,
        "tasks": true,
        "webmeet": true,
        "soul-gateway": true
    },
    "routerAccess": {
        "requiredCapability": "explorer.access",
        "capabilityDeniedRedirect": "/base-agent-additional-server/userPersistoAgent/7000/service/dashboard/",
        "httpRoutes": [
            {
                "path": "/shared/*",
                "access": "public"
            },
            {
                "path": "/web-components/components/*",
                "access": "public"
            }
        ]
    },
    "profiles": {
        "default": {
            "env": [
                "ASSISTOS_FS_ROOT",
                {
                    "name": "AXIFACE_REPO_PATH",
                    "required": false
                },
                {
                    "name": "PLOINKY_TOOL_WORKERS",
                    "value": "0"
                }
            ],
            "preinstall": "scripts/hooks/preinstall.sh"
        }
    }
}
