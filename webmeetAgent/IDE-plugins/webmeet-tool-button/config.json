{
    "pluginCategory": "application",
    "id": "webmeet",
    "component": "webmeet-tool-button",
    "location": ["file-exp:toolbar"],
    "locationOrder": 300,
    "label": "WebMeet",
    "tooltip": "WebMeet collaboration",
    "icon": "./icon.svg",
    "presenter": "WebMeetToolButton",
    "type": "embedded",
    "autoPin": false,
    "toolbarModal": {
        "mode": "iframe",
        "url": "/webmeetAgent/roomLoader.html",
        "agentRef": "AchillesIDE/webmeetAgent",
        "fullscreen": true
    },
    "dependencies": [
        {
            "component": "webmeet-dashboard",
            "presenter": "WebmeetDashboard",
            "path": "components/webmeet-dashboard/webmeet-dashboard"
        },
        {
            "component": "webmeet-settings-modal",
            "presenter": "WebmeetSettingsModal",
            "type": "modal"
        },
        {
            "component": "create-room-modal",
            "presenter": "CreateRoomModal",
            "type": "modal"
        },
        {
            "component": "webmeet-guest-entry-modal",
            "presenter": "WebmeetGuestEntryModal",
            "type": "modal"
        },
        {
            "component": "webmeet-participant-audio-modal",
            "presenter": "WebmeetParticipantAudioModal",
            "type": "modal"
        },
        {
            "component": "webmeet-room-settings-modal",
            "presenter": "WebmeetRoomSettingsModal",
            "type": "modal"
        },
        {
            "component": "custom-select",
            "presenter": "CustomSelect",
            "agent": "explorer",
            "baseUrl": "/explorer/web-components/components/custom-select/custom-select"
        },
        {
            "component": "webmeet-participant-card",
            "presenter": "WebMeetParticipantCard"
        },
        {
            "component": "webmeet-blackboard-panel",
            "presenter": "WebMeetBlackboardPanel",
            "path": "components/webmeet-blackboard/webmeet-blackboard-panel/webmeet-blackboard-panel"
        },
        {
            "component": "webmeet-blackboard-toolbar",
            "presenter": "WebMeetBlackboardToolbar",
            "path": "components/webmeet-blackboard/webmeet-blackboard-toolbar/webmeet-blackboard-toolbar"
        },
        {
            "component": "webmeet-blackboard-widget-editor",
            "presenter": "WebMeetBlackboardWidgetEditor",
            "type": "modal",
            "path": "components/webmeet-blackboard/webmeet-blackboard-widget-editor/webmeet-blackboard-widget-editor"
        },
        {
            "component": "webmeet-scripta-document-modal",
            "presenter": "WebMeetScriptaDocumentModal",
            "type": "modal",
            "path": "components/webmeet-blackboard/webmeet-scripta-document-modal/webmeet-scripta-document-modal"
        },
        {
            "component": "scripta-variants-view",
            "presenter": "ScriptaVariantsView",
            "baseUrl": "/explorer/shared/ui/scripta-variants-view/scripta-variants-view"
        },
        {
            "component": "webmeet-blackboard-poll-modal",
            "presenter": "WebMeetBlackboardPollModal",
            "type": "modal",
            "path": "components/webmeet-blackboard/webmeet-blackboard-poll-modal/webmeet-blackboard-poll-modal"
        },
        {
            "component": "webmeet-blackboard-poll-results-modal",
            "presenter": "WebMeetBlackboardPollResultsModal",
            "type": "modal",
            "path": "components/webmeet-blackboard/webmeet-blackboard-poll-results-modal/webmeet-blackboard-poll-results-modal"
        },
        {
            "component": "webmeet-blackboard-results-panel",
            "presenter": "WebMeetBlackboardResultsPanel",
            "path": "components/webmeet-blackboard/webmeet-blackboard-results-panel/webmeet-blackboard-results-panel"
        }
    ]
}
