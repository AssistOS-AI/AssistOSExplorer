# rwp7: the proof-fixture image of slice P7. The rwworker image (built from tests/g7/fixture/rwworker/Containerfile at
# the same candidate and passed by digest) plus the rwcoord fixture and the server modules coordinatorAuth.mjs imports.
# One image serves three Ploinky agents with different manifests (render-manifests.mjs): the worker (whose start command
# is the admission front), the declared coordinator and an undeclared agent. No listener other than the front, which
# binds loopback inside the worker container.
#
# Build context (assembled by the operator): robo/server/ (the whole robo-work server tree of the candidate) and
# robo/tests/g7/fixture/rwcoord/ WITHOUT localRouter.mjs (the LOCAL Router stand-in is never part of the image; the build
# fails if it is present).
ARG RWWORKER_IMAGE
FROM ${RWWORKER_IMAGE}

COPY robo/server/ /opt/rwworker/robo-work/server/
COPY robo/tests/g7/fixture/rwcoord/ /opt/rwworker/robo-work/tests/g7/fixture/rwcoord/
RUN test ! -e /opt/rwworker/robo-work/tests/g7/fixture/rwcoord/localRouter.mjs \
    && find /opt/rwworker -type d -exec chmod 0555 {} + && find /opt/rwworker -type f -exec chmod 0444 {} + \
    && found="$(find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -print)" \
    && if [ -n "$found" ]; then echo "setuid/setgid files: $found" >&2; exit 1; fi

WORKDIR /opt/rwworker/robo-work/tests/g7/fixture/rwcoord
ENTRYPOINT []
