# rwtarget: the worker-owned proof-fixture execution target (proof slice P3; target-selection option (a)).
# A minimal digest-pinned base, the fixed target helper, keeper and file server built statically from the reviewed
# robo-work/native sources, Bubblewrap at /usr/bin/bwrap, setpriv for the peer's privilege drop, Node at
# /usr/local/bin/node with the provider endpoint code, the management launcher and the distinct non-management peer.
# No setuid/setgid file; no network or service of its own.
#
# The keeper sits at the keeper domain policy's fixed paths (keeper/src/domain_policy.rs: Node /usr/local/bin/node,
# keeper /usr/local/libexec/robo-work/keeper; bwrap.rs: /usr/bin/bwrap). It is the `--features apparatus-policy` build:
# its image policy (first-G1 amendment A1.6) pins Node, Bubblewrap and the workload inventory with their loader and
# DT_NEEDED closures, and the endpoint code, by the digests they have in this image. The policy is therefore generated
# from the `base` stage, built into the keeper, and then the final stage adds the binaries on top of the unchanged base:
#
#   1. podman build --target base -t <base> <context>            (the files the policy pins)
#   2. generate the policy from <base>; build the keeper with RW_KEEPER_APPARATUS_POLICY_FILE=<policy>
#   3. podman build -t <image> <context>                         (the base layers must be the layers of <base>)
#   4. regenerate the policy from <image>: it must be byte-identical; render-manifest.mjs --keeper-policy checks that
#      every pinned file is inventoried with its digest
#
# Build context (assembled by the operator): this directory, bin/rw-target-helper, bin/keeper, bin/rw-file-server
# (x86_64-unknown-linux-musl static release builds) and server/execution/ (the seven provider endpoint modules below,
# copied from robo-work/server/execution). The helper is the DEFAULT build (no `proof-fixture` feature): launch.sh
# starts it with --secret-file only, so it verifies Router-minted tickets with its per-incarnation secret (mint route spec
# 2026-10-30; the worker uses rwworker `--router-tickets`). The proof-fixture session and its public key remain only for
# the helper crate tests and the rwworker selftest. Since P8 the helper launches one keeper per execution (its keeper
# supervisor; the workload is an inventory name from the keeper policy).
# The image declares nothing else; its manifest (manifest.template.json, rendered by render-manifest.mjs) declares
# containerSecurity.nestedPodman and executionTarget.
FROM docker.io/library/alpine:3.22@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f AS base

# Node is moved to the policy path; nothing remains at /usr/bin/node.
RUN apk add --no-cache bubblewrap=0.12.0-r0 setpriv=2.41.6-r1 nodejs=22.23.4-r0 \
    && mkdir -p /usr/local/bin && mv /usr/bin/node /usr/local/bin/node && chmod 0555 /usr/local/bin/node

COPY --chmod=0444 server/execution/providerEndpointMain.mjs server/execution/providerEndpoint.mjs server/execution/channelTransport.mjs \
    server/execution/endpointFrames.mjs server/execution/executionLimits.mjs server/execution/frameCodec.mjs server/execution/providerSchema.mjs \
    /opt/robo-work/server/execution/

FROM base

COPY --chmod=0555 bin/rw-target-helper /usr/libexec/ploinky-target/rw-target-helper
COPY --chmod=0555 bin/keeper /usr/local/libexec/robo-work/keeper
COPY --chmod=0555 bin/rw-file-server /usr/libexec/ploinky-target/rw-file-server
COPY --chmod=0555 launch.sh /usr/libexec/ploinky-target/launch
COPY --chmod=0555 peer.sh /usr/libexec/ploinky-target/peer

# The image must carry no setuid or setgid file (bwrap included) and nothing at the old keeper path; the build fails
# otherwise.
RUN test -x /usr/bin/bwrap && test -x /bin/setpriv && test -x /usr/local/bin/node && test ! -e /usr/bin/node \
    && test -x /usr/local/libexec/robo-work/keeper && test ! -e /usr/libexec/ploinky-target/keeper \
    && found="$(find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -print)" \
    && if [ -n "$found" ]; then echo "setuid/setgid files: $found" >&2; exit 1; fi

ENTRYPOINT []
CMD ["/usr/libexec/ploinky-target/launch"]
