# rwworker: the proof-fixture worker image (slice P6b; decision B2). The worker host composed from the unchanged
# production robo-work/server/executionTarget modules, the rwworker fixture, the operator tool that installs the
# qualification record, the session vectors (the public fixture ticket key) and the default (non-fixture) static
# rw-target-helper build for the native worker-side peer (decision B4). No service, listener or network of its own.
#
# Build context (assembled by the operator): a robo-work subset at robo/ (server/executionTarget, tests/g7/fixture/rwworker,
# tests/g7/tools/install-fixture-record.mjs, native/crates/target-helper/tests/vectors/session-fixture-v1.json) and
# bin/rw-target-helper. The base is the Node image Ploinky already uses for agents, by digest.
FROM docker.io/library/node:24-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d

COPY --chmod=0555 bin/rw-target-helper /usr/libexec/rwworker/rw-target-helper
COPY robo/ /opt/rwworker/robo-work/
# The Debian base carries setuid/setgid utilities (su, mount, passwd, ...); the image keeps none of those bits.
RUN find /opt/rwworker -type d -exec chmod 0555 {} + && find /opt/rwworker -type f -exec chmod 0444 {} + \
    && find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod ug-s {} + \
    && found="$(find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -print)" \
    && if [ -n "$found" ]; then echo "setuid/setgid files: $found" >&2; exit 1; fi

WORKDIR /opt/rwworker/robo-work/tests/g7/fixture/rwworker
ENTRYPOINT ["node", "/opt/rwworker/robo-work/tests/g7/fixture/rwworker/main.mjs"]
