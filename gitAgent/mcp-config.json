      "cwd": "workspace",
      "inputSchema": {
        "path": { "type": "string", "optional": false },
        "operation": { "type": "string", "enum": ["commit", "push"], "optional": false },
        "remote": { "type": "string", "optional": true },
        "branch": { "type": "string", "optional": true },
        "setUpstream": { "type": "boolean", "optional": true },
        "approvedLargeFileOids": { "type": "array", "items": { "type": "string" }, "optional": true }
      },
      "env": { "TOOL_NAME": "git_check_large_files" }
    },
