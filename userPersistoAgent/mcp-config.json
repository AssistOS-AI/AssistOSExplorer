        {
            "name": "userpersisto_oidc_client_create",
            "title": "Register OAuth2/OIDC client",
            "description": "Admin: register a browser or confidential service client. Confidential client secrets are generated and returned once.",
            "command": "sh",
            "args": [
                "tools/userpersisto_tool.sh"
            ],
            "cwd": "/code",
            "timeoutMs": 30000,
            "inputSchema": {
                "type": "object",
                "properties": {
                    "client_id": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{2,127}$"
                    },
                    "client_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    },
                    "redirect_uris": {
                        "type": "array",
                        "maxItems": 20,
                        "items": {
                            "type": "string",
                            "maxLength": 2048
                        }
                    },
                    "post_logout_redirect_uris": {
                        "type": "array",
                        "maxItems": 20,
                        "items": {
                            "type": "string",
                            "maxLength": 2048
                        }
                    },
                    "token_endpoint_auth_method": {
                        "type": "string",
                        "enum": [
                            "none",
                            "client_secret_basic",
                            "client_secret_post"
                        ]
                    },
                    "grant_types": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "type": "string",
                            "enum": [
                                "authorization_code",
                                "refresh_token",
                                "client_credentials"
                            ]
                        }
                    },
                    "response_types": {
                        "type": "array",
                        "maxItems": 1,
                        "items": {
                            "type": "string",
                            "enum": [
                                "code"
                            ]
                        }
                    },
                    "scope": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                    },
                    "enabled": {
                        "type": "boolean"
                    }
                },
                "additionalProperties": false
            },
            "tags": [
                "admin"
            ],
            "env": {
                "TOOL_NAME": "userpersisto_oidc_client_create"
            }
        },
