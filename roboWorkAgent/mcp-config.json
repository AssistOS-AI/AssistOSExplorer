    {
      "name": "run_start",
      "description": "Internal robot runtime operation: run_start.",
      "command": "node",
      "args": [
        "tools/robowork.mjs",
        "run_start"
      ],
      "cwd": "/code",
      "tags": [
        "internal"
      ],
      "timeoutMs": 180000,
      "inputSchema": {
        "runId": {
          "type": "string"
        },
        "robotId": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "ala": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "turnId": {
              "type": "string",
              "optional": true
            },
            "permissions": {
              "type": "string",
              "enum": [
                "full-access",
                "ask-for-approval"
              ],
              "optional": true
            },
            "model": {
              "type": "string",
              "optional": true
            },
            "effort": {
              "type": "string",
              "optional": true
            },
            "ca": {
              "type": "string",
              "enum": [
                "auto",
                "codex",
                "opencode",
                "pi",
                "claude"
              ],
              "optional": true
            },
            "resume": {
              "type": "boolean",
              "optional": true
            },
            "workflowExecution": {
              "type": "boolean",
              "optional": true
            },
            "mcpServers": {
              "type": "any",
              "description": "Existing MCP server string or array; retained for ALA validation.",
              "optional": true
            }
          }
        },
        "folders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "alias": {
                "type": "string",
                "optional": true
              },
              "at": {
                "type": "string",
                "optional": true
              },
              "expose": {
                "type": "boolean",
                "optional": true
              }
            }
          }
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "ploinky-runtime",
                  "human-input",
                  "task-failure"
                ]
              },
              "alias": {
                "type": "string",
                "optional": true
              },
              "context": {
                "type": "object",
                "additionalProperties": true,
                "optional": true
              }
            }
          }
        },
        "gui": {
          "type": "object",
          "optional": true,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "browser",
                "desktop"
              ]
            },
            "cwd": {
              "type": "string",
              "optional": true
            },
            "allowReplace": {
              "type": "boolean",
              "optional": true
            }
          }
        },
        "environment": {
          "type": "string",
          "optional": true
        },
        "tag": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    {
      "name": "run_read",
