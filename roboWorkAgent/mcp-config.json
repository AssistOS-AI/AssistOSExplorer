          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "type": "number",
              "optional": true
            },
            "body": {
              "type": "any",
              "description": "Opaque JSON callback response, including object, array, scalar or null.",
              "optional": true
            }
          }
        }
